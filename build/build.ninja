  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D Z:\BluemanEditor\build\_deps\glfw-src\src && C:\msys64\ucrt64\bin\cmake.exe -P Z:/BluemanEditor/build/_deps/glfw-src/CMake/GenerateMappings.cmake mappings.h.in mappings.h"
  DESC = Updating gamepad mappings from upstream repository

